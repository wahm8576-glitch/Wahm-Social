# Public base URL used for canonical links, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=https://wahm-social.onrender.com
# Secret used to sign JWT session cookies (generate a long random string)
JWT_SECRET=change-me
# Comma-separated admin emails (get /admin access)
ADMIN_EMAILS=
# Optional Instagram session cookie value for higher reliability on public endpoints (never commit)
IG_SESSIONID=
# Optional extra cookies from the same Instagram browser session (improves reliability)
IG_CSRFTOKEN=
IG_DS_USER_ID=
IG_MID=
IG_DATR=
# Optional outbound HTTP proxy for scraping (http://user:pass@host:port).
# When set, Instagram, TikTok, and tikwm.com/countik.com fallbacks are routed through it (a home-router or residential proxy works).
SCRAPER_PROXY=
# Optional Cloudflare Worker relay for www.tiktok.com, tikwm.com, and countik.com
# (used instead of a direct/datacenter fetch for those GET hosts). Example: https://name.workers.dev
RELAY_URL=
# PayPal Subscriptions (primary). When unset in production, checkout is disabled.
# In local development only, checkout runs in mock mode (free upgrade) if these are empty.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox
PAYPAL_PLAN_PRO_MONTHLY=
PAYPAL_PLAN_PRO_YEARLY=
PAYPAL_PLAN_BIZ_MONTHLY=
PAYPAL_PLAN_BIZ_YEARLY=
# Stripe (optional fallback). Unused when PayPal is configured.
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_WEBHOOK_SECRET=
# Force demo data when platforms block requests: auto | on | off
DEMO_MODE=auto
# Where JSON data store lives
DATA_DIR=./data

# Optional: official TikTok Research API (public follower/following lists)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Optional TikTok web session cookie (sessionid) — tried as a plain cookie for follower lists
TIKTOK_SESSIONID=
# Full TikTok Cookie header from a logged-in browser (preferred over TIKTOK_SESSIONID alone)
TIKTOK_COOKIE=
# Admin panel (secret URL /<ADMIN_PATH>/). Password is stored ONLY as a bcrypt hash.
ADMIN_PATH=
ADMIN_PASSWORD_HASH=
# Durable settings store: private GitHub repo (owner/name) + write deploy key (base64 of the OpenSSH private key).
# Optional alternative to the deploy key: ADMIN_GITHUB_TOKEN (contents:write on that repo only).
ADMIN_DATA_REPO=
ADMIN_DATA_SSH_KEY=
